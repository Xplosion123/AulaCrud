@model List<AulaCrud.Models.Contatos>
 
@{
    ViewData["Title"] = "Contatos";
}
 
<h2>Contatos</h2>
 
<a asp-action="CadastrarContato" class="btn btn-primary mb-3">Cadastrar novo contato</a>
 
<table class="table table-striped">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Telefone</th>
            <th>Email</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var contato in Model)
        {
            <tr>
                <td>@contato.Nome</td>
                <td>@contato.Tel</td>
                <td>@contato.Email</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@contato.Id" class="btn btn-sm btn-warning">Editar</a>
 
                    <form asp-action="Delete" asp-route-id="@contato.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Deseja realmente excluir este contato?');">
                        <button type="submit" class="btn btn-sm btn-danger">Excluir</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (TempData["Mensagem"] != null)
{
    <script>
        alert("@TempData["Mensagem"]");
    </script>
}
